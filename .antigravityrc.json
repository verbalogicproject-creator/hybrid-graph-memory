    "dimensions": 768
  },
  "local": {
    "embedderUrl": "http://127.0.0.1:8145/v1/embeddings",
    "rerankerUrl": "http://127.0.0.1:8144/v1/rerank",
    "generatorUrl": "http://127.0.0.1:8147/v1/chat/completions",
    "generatorModels": [
      "qwen2.5-3b-instruct-q4_0",
      "microsoft_Phi-4-mini-instruct",
